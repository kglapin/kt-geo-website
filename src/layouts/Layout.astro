---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "KT-GEO Sp. z o.o. - Usługi geodezyjne w Oleśnicy i okolicach. Mapy do celów projektowych, tyczenie budynków, inwentaryzacje powykonawcze, podziały nieruchomości i sprawy graniczne." } = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'KTGEO Sp. z o.o.',
  description,
  telephone: '+48 791 122 618',
  email: 'geodezjakamilnowakowski@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ul. Brzozowa 10M/3',
    postalCode: '56-400',
    addressLocality: 'Oleśnica',
    addressCountry: 'PL'
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Oleśnica i okolice'
  },
  knowsAbout: [
    'mapy do celów projektowych',
    'tyczenie budynków',
    'inwentaryzacja powykonawcza',
    'podziały nieruchomości',
    'sprawy graniczne'
  ]
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/kt-geo-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class="flex flex-col min-h-screen bg-white text-[#111] selection:bg-brand-red selection:text-white">
    <slot />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      const header = document.querySelector('header');
      if (header) {
        ScrollTrigger.create({
          start: 'top -50',
          end: 99999,
          toggleClass: { className: 'header-scrolled', targets: header }
        });
      }

      const heroBgImg = document.getElementById('hero-bg-img');
      if (heroBgImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.to(heroBgImg, {
          scale: 1.06,
          duration: 16,
          ease: 'sine.inOut',
          yoyo: true,
          repeat: -1
        });
      }

      const heroH1 = document.querySelector('[data-hero-h1]');
      const heroP = document.querySelector('[data-hero-p]');
      const heroCta = document.querySelector('[data-hero-cta]');

      if (heroH1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.from(heroH1, { y: 32, opacity: 0, duration: 0.9 })
          .from(heroP, { y: 22, opacity: 0, duration: 0.7 }, '-=0.45')
          .from(heroCta, { y: 16, opacity: 0, duration: 0.55 }, '-=0.3');
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('[data-animate]').forEach(function(el) {
          gsap.from(el, {
            y: 28,
            opacity: 0,
            duration: 0.7,
            ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 88%' }
          });
        });
      }
    </script>
  </body>
</html>
