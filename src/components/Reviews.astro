---
const reviews = [
  {
    name: 'Jakub Fidala',
    text: 'Szybko sprawnie i w dobrej cenie, polecam'
  },
  {
    name: 'Gabriela Siemaszko',
    text: 'Jestem bardzo zadowolona z usług. Udało się wszystko omówić i odebrać zdalnie, ponieważ przebywam za granicą. Pan geodeta bardzo elastyczny i kontaktowy, polecam!'
  },
  {
    name: 'Dawid Kotrys',
    text: 'Geodeta godny polecenia. Wszystko wykonane sprawnie i w ustalonym terminie, bez niepotrzebnego przeciągania. Dobry kontakt, konkretne ustalenia i brak problemów z dokumentacją potrzebną do dalszych etapów budowy. Widać doświadczenie i dobre podejście do inwestora – wszystko było jasno wytłumaczone, więc nie było żadnych niespodzianek. Jeśli będę jeszcze potrzebował usług geodezyjnych, na pewno wrócę.'
  }
];
---
<section id="opinie" class="py-20 md:py-28 bg-brand-black scroll-mt-16">
  <div class="main-grid-container">
    <div class="flex flex-col gap-4 mb-14" data-animate>
      <span class="text-sm font-display font-medium text-brand-red tracking-widest uppercase">Opinie</span>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-white tracking-tight">Co mówią klienci</h2>
    </div>

    <div class="flex flex-col gap-6">
      <!-- First 2 reviews: 50/50 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {reviews.slice(0, 2).map((review) => (
          <div class="flex flex-col gap-5 p-8 rounded-xl border border-white/10" data-animate>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-red opacity-60" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
            </svg>
            <p class="text-white/70 leading-relaxed text-[15px]">{review.text}</p>
            <div class="mt-auto pt-4 border-t border-white/10 flex items-center justify-between">
              <p class="font-display font-semibold text-white text-sm">{review.name}</p>
              <span class="text-[10px] text-white/20 tracking-wider uppercase">Google</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Last review: full width -->
      <div class="flex flex-col gap-5 p-8 rounded-xl border border-white/10" data-animate>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-red opacity-60" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
        </svg>
        <p class="text-white/70 leading-relaxed text-[15px]">{reviews[2].text}</p>
        <div class="mt-auto pt-4 border-t border-white/10 flex items-center justify-between">
          <p class="font-display font-semibold text-white text-sm">{reviews[2].name}</p>
          <span class="text-[10px] text-white/20 tracking-wider uppercase">Google</span>
        </div>
      </div>
    </div>
  </div>
</section>
