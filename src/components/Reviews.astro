---
const reviews = [
  {
    name: 'Gabriela Siemaszko',
    text: 'Jestem bardzo zadowolona z usług. Udało się wszystko omówić i odebrać zdalnie, ponieważ przebywam za granicą. Pan geodeta bardzo elastyczny i kontaktowy, polecam!'
  },
  {
    name: 'Dawid Kotrys',
    text: 'Geodeta godny polecenia. Wszystko wykonane sprawnie i w ustalonym terminie, bez niepotrzebnego przeciągania. Dobry kontakt, konkretne ustalenia i brak problemów z dokumentacją potrzebną do dalszych etapów budowy.'
  },
  {
    name: 'Jakub Fidala',
    text: 'Szybko sprawnie i w dobrej cenie, polecam.'
  }
];
---

<section id="opinie" class="py-20 md:py-28 bg-brand-black text-white scroll-mt-16">
  <div class="main-grid-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-4" data-animate>
        <p class="type-eyebrow">Opinie klientów</p>
        <h2 class="type-display-lg text-white mt-5 max-w-[8ch]">Po wykonanej pracy.</h2>
      </div>

      <div class="lg:col-span-8 border-t border-white/15" data-animate>
        {reviews.map((review, index) => (
          <article class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 py-8 md:py-10 border-b border-white/15">
            <div class="md:col-span-1 type-meta text-white/30">0{index + 1}</div>
            <blockquote class="md:col-span-8 text-[1.125rem] md:text-[1.25rem] leading-[1.5] tracking-[-0.01em] text-white/78 max-w-[50ch]">„{review.text}”</blockquote>
            <div class="md:col-span-3 md:text-right">
              <p class="text-[0.9375rem] leading-snug font-semibold text-white">{review.name}</p>
              <p class="type-meta text-white/28 mt-2">opinia Google</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
