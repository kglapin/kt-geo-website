---
---
<section id="kontakt" class="py-20 md:py-28 bg-[#f5f5f5] scroll-mt-16">
  <div class="main-grid-container flex flex-col gap-14">
    <div class="flex flex-col gap-4" data-animate>
      <span class="text-sm font-display font-medium text-brand-red tracking-widest uppercase">Kontakt</span>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-[#111] tracking-tight">Zróbmy pierwszy krok. To darmowe.</h2>
      <p class="text-[#666] text-lg max-w-xl">Wycena jest bezpłatna. Opisz projekt — oddzwonimy w 15 minut z konkretną propozycją.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Form -->
      <div class="lg:col-span-7" data-animate>
        <form id="geodesy-form" class="flex flex-col gap-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-sm font-medium text-[#111]">Imię</label>
              <input type="text" id="name" name="name" required placeholder="Jan"
                class="w-full px-4 py-3 rounded-lg border border-[#e5e5e5] bg-white focus:outline-none focus:border-[#111] transition-colors text-sm" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="phone" class="text-sm font-medium text-[#111]">Telefon</label>
              <input type="tel" id="phone" name="phone" required placeholder="500 600 700"
                class="w-full px-4 py-3 rounded-lg border border-[#e5e5e5] bg-white focus:outline-none focus:border-[#111] transition-colors text-sm" />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-sm font-medium text-[#111]">Email</label>
            <input type="email" id="email" name="email" placeholder="jan@email.com"
              class="w-full px-4 py-3 rounded-lg border border-[#e5e5e5] bg-white focus:outline-none focus:border-[#111] transition-colors text-sm" />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="stage" class="text-sm font-medium text-[#111]">Na jakim etapie jesteś?</label>
            <select id="stage" name="stage" required
              class="w-full px-4 py-3 rounded-lg border border-[#e5e5e5] bg-white focus:outline-none focus:border-[#111] transition-colors text-sm">
              <option value="" disabled selected>Wybierz...</option>
              <option value="planuje">Planuję budowę — potrzebuję mapy do celów projektowych</option>
              <option value="buduje">Buduję — potrzebuję tyczenia budynku</option>
              <option value="koncze">Kończę budowę — potrzebuję inwentaryzacji</option>
              <option value="granica">Sprawa graniczna — podział lub wznowienie</option>
              <option value="inne">Inna sprawa geodezyjna</option>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-sm font-medium text-[#111]">Opisz, czego potrzebujesz</label>
            <textarea id="message" name="message" rows="4" placeholder="np. Potrzebuję mapy do celów projektowych dla działki nr 123 w Oleśnicy..."
              class="w-full px-4 py-3 rounded-lg border border-[#e5e5e5] bg-white focus:outline-none focus:border-[#111] transition-colors text-sm resize-none"></textarea>
          </div>

          <label for="rodo" class="flex items-start gap-3 cursor-pointer py-1">
            <input type="checkbox" id="rodo" name="rodo" required class="rodo-checkbox" />
            <span class="text-xs text-[#666] leading-relaxed">
              Wyrażam zgodę na przetwarzanie danych osobowych w celu przygotowania bezpłatnej wyceny.
            </span>
          </label>

          <button type="submit"
            class="w-full bg-[#111] text-white font-display font-semibold py-3.5 rounded-lg transition-all hover:bg-brand-red text-sm tracking-wide">
            Wyślij niezobowiązujące zapytanie
          </button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="lg:col-span-5 flex flex-col gap-8" data-animate>
        <div class="flex flex-col gap-6">
          <div class="flex items-start gap-4">
            <div class="w-1 h-1 rounded-full bg-brand-red mt-2.5 shrink-0"></div>
            <div>
              <p class="font-display font-semibold text-[#111] text-sm">Adres</p>
              <p class="text-sm text-[#666]">ul. Brzozowa 10M/3</p>
              <p class="text-sm text-[#666]">56-400 Oleśnica</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-1 h-1 rounded-full bg-brand-red mt-2.5 shrink-0"></div>
            <div>
              <p class="font-display font-semibold text-[#111] text-sm">Telefon</p>
              <a href="tel:791122618" class="text-sm text-[#666] hover:text-brand-red transition-colors">791 122 618</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-1 h-1 rounded-full bg-brand-red mt-2.5 shrink-0"></div>
            <div>
              <p class="font-display font-semibold text-[#111] text-sm">Godziny pracy</p>
              <p class="text-sm text-[#666]">Pon-Pt: 8:00 – 16:00</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-1 h-1 rounded-full bg-brand-red mt-2.5 shrink-0"></div>
            <div>
              <p class="font-display font-semibold text-[#111] text-sm">Firma</p>
              <p class="text-sm text-[#666]">KTGEO Sp. z o.o.</p>
              <p class="text-sm text-[#666]">NIP: 9112051898</p>
              <p class="text-sm text-[#666]">KRS: 0001094982</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden h-[200px] border border-[#e5e5e5]">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2500!2d17.397!3d51.213!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470fc1e5a3b3c5b1%3A0x123456!2sBrzozowa+10M%2C+56-400+Ole%C5%9Bnica!5e0!3m2!1spl!2spl"
            class="w-full h-full border-0 grayscale"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokalizacja KT-GEO"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('geodesy-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const orig = btn.innerText;
      btn.disabled = true;
      btn.innerText = 'Wysyłanie...';
      setTimeout(() => {
        btn.style.backgroundColor = '#10B981';
        btn.innerText = 'Wysłano! Oddzwonimy w 15 minut.';
        form.reset();
        setTimeout(() => {
          btn.disabled = false;
          btn.style.backgroundColor = '';
          btn.innerText = orig;
        }, 3000);
      }, 1500);
    });
  }
</script>
