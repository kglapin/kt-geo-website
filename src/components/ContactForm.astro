---
---
<section id="kontakt" class="py-20 md:py-28 bg-[#f3f3f1] scroll-mt-16">
  <div class="main-grid-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      <div class="lg:col-span-5" data-animate>
        <p class="type-eyebrow">Kontakt</p>
        <h2 class="type-display-lg mt-5 max-w-[10ch]">Zapytaj o usługę geodezyjną.</h2>
        <p class="type-lead text-[#555] mt-6 max-w-[43ch]">Podaj lokalizację i krótko opisz sprawę. Jeśli znasz numer działki, dopisz go w formularzu.</p>

        <div class="mt-10 pt-7 border-t border-[#d5d5d2] space-y-7">
          <div>
            <p class="type-meta text-[#8c8c8c]">Telefon</p>
            <a href="tel:791122618" class="inline-block font-display font-semibold text-[1.85rem] leading-tight tracking-[-0.025em] text-[#111] mt-1.5 hover:text-brand-red transition-colors">791 122 618</a>
          </div>
          <div>
            <p class="type-meta text-[#8c8c8c]">E-mail</p>
            <a href="mailto:geodezjakamilnowakowski@gmail.com" class="inline-block text-[1.0625rem] leading-snug text-[#111] mt-1.5 hover:text-brand-red transition-colors break-all">geodezjakamilnowakowski@gmail.com</a>
          </div>
          <div>
            <p class="type-meta text-[#8c8c8c]">Adres</p>
            <p class="text-[1.0625rem] leading-[1.5] text-[#555] mt-1.5">ul. Brzozowa 10M/3<br />56-400 Oleśnica</p>
          </div>
          <div class="type-meta normal-case tracking-[0.025em] text-[#888] pt-2">KTGEO Sp. z o.o. · NIP 9112051898 · KRS 0001094982</div>
        </div>
      </div>

      <div class="lg:col-span-7" data-animate>
        <form id="geodesy-form" class="border-t border-[#cfcfcb]">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 border-b border-[#cfcfcb] py-6">
            <div class="sm:col-span-2">
              <label for="service" class="form-label">Rodzaj sprawy</label>
              <select id="service" name="service" required class="form-field mt-2">
                <option value="" disabled selected>Wybierz usługę</option>
                <option value="mapa">Mapa do celów projektowych</option>
                <option value="tyczenie">Tyczenie budynku / obiektu</option>
                <option value="inwentaryzacja">Inwentaryzacja powykonawcza</option>
                <option value="podzial">Podział działki / nieruchomości</option>
                <option value="granice">Granice / wznowienie / ustalenie</option>
                <option value="inne">Inna sprawa geodezyjna</option>
                <option value="nie-wiem">Nie wiem, czego potrzebuję</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 border-b border-[#cfcfcb] py-6">
            <div>
              <label for="location" class="form-label">Miejscowość / lokalizacja</label>
              <input type="text" id="location" name="location" required placeholder="np. Oleśnica" class="form-field mt-2" />
            </div>
            <div>
              <label for="parcel" class="form-label">Numer działki <span class="font-normal text-[#999]">(opcjonalnie)</span></label>
              <input type="text" id="parcel" name="parcel" placeholder="np. 123/4" class="form-field mt-2" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 border-b border-[#cfcfcb] py-6">
            <div>
              <label for="name" class="form-label">Imię</label>
              <input type="text" id="name" name="name" required placeholder="Jan" class="form-field mt-2" />
            </div>
            <div>
              <label for="phone" class="form-label">Telefon</label>
              <input type="tel" id="phone" name="phone" required placeholder="500 600 700" class="form-field mt-2" />
            </div>
          </div>

          <div class="border-b border-[#cfcfcb] py-6">
            <label for="message" class="form-label">Krótki opis sprawy <span class="font-normal text-[#999]">(opcjonalnie)</span></label>
            <textarea id="message" name="message" rows="4" placeholder="Napisz, czego dotyczy zlecenie..." class="form-field mt-2 resize-none"></textarea>
          </div>

          <label for="rodo" class="flex items-start gap-3 cursor-pointer py-6">
            <input type="checkbox" id="rodo" name="rodo" required class="rodo-checkbox" />
            <span class="text-[0.8125rem] leading-[1.45] text-[#666]">Wyrażam zgodę na przetwarzanie podanych danych w celu kontaktu w sprawie mojego zapytania.</span>
          </label>

          <button type="submit" class="inline-flex items-center justify-center bg-brand-red text-white text-[0.9375rem] leading-none font-semibold tracking-[-0.006em] py-[1.05rem] px-7 transition-colors hover:bg-brand-red-dark">
            Przygotuj wiadomość e-mail
          </button>
          <p class="text-[0.8125rem] leading-[1.45] text-[#888] mt-3">Formularz otworzy gotową wiadomość w Twoim programie pocztowym.</p>
          <p id="form-status" class="hidden text-[0.9375rem] mt-4 text-[#555]" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('geodesy-form') as HTMLFormElement | null;
  const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
  const status = document.getElementById('form-status');

  document.querySelectorAll<HTMLElement>('[data-service]').forEach((link) => {
    link.addEventListener('click', () => {
      const value = link.dataset.service;
      if (!value || !serviceSelect) return;
      const option = Array.from(serviceSelect.options).find((item) => item.value === value);
      if (option) serviceSelect.value = value;
    });
  });

  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const serviceLabel = serviceSelect?.selectedOptions[0]?.textContent || 'Sprawa geodezyjna';
      const location = String(data.get('location') || '');
      const parcel = String(data.get('parcel') || 'nie podano');
      const name = String(data.get('name') || '');
      const phone = String(data.get('phone') || '');
      const message = String(data.get('message') || 'brak dodatkowych informacji');

      const subject = `Zapytanie ze strony KT-GEO — ${serviceLabel}`;
      const body = [
        `Dzień dobry,`,
        ``,
        `proszę o kontakt w sprawie usługi geodezyjnej.`,
        ``,
        `Rodzaj sprawy: ${serviceLabel}`,
        `Lokalizacja: ${location}`,
        `Numer działki / obręb: ${parcel}`,
        `Imię: ${name}`,
        `Telefon: ${phone}`,
        `Dodatkowa informacja: ${message}`,
        ``,
        `Pozdrawiam,`,
        name
      ].join('\n');

      if (status) {
        status.classList.remove('hidden');
        status.textContent = 'Wiadomość została przygotowana. Jeśli program pocztowy się nie otworzył, skorzystaj z telefonu lub adresu e-mail obok formularza.';
      }

      window.location.href = `mailto:geodezjakamilnowakowski@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
