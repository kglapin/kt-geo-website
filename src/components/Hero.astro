---
<section class="relative bg-brand-black text-white overflow-hidden">
  <div class="main-grid-container grid grid-cols-1 lg:grid-cols-12 min-h-[calc(100vh-4rem)] lg:min-h-[760px] items-center gap-10 lg:gap-14 py-14 md:py-20 lg:py-16">
    <div class="lg:col-span-6 xl:col-span-5" data-hero-content>
      <p class="text-sm font-display font-medium tracking-[0.16em] uppercase text-brand-red mb-6">Geodezja i kartografia · Oleśnica</p>

      <h1 data-hero-h1 class="font-display font-bold text-[2.8rem] sm:text-5xl md:text-6xl lg:text-[4.4rem] tracking-[-0.045em] leading-[0.98] max-w-4xl">
        Usługi geodezyjne w Oleśnicy i okolicach.
      </h1>

      <p data-hero-p class="text-base sm:text-lg md:text-xl text-white/60 max-w-xl leading-relaxed mt-7">
        Mapy do celów projektowych, tyczenie budynków, inwentaryzacje powykonawcze, podziały nieruchomości oraz prace związane z granicami działek.
      </p>

      <div data-hero-cta class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mt-8">
        <a href="#kontakt" class="inline-flex items-center justify-center bg-brand-red text-white font-display font-semibold px-7 py-4 transition-colors hover:bg-brand-red-dark">
          Zapytaj o wycenę
        </a>
        <a href="tel:791122618" class="inline-flex items-center justify-center gap-2 px-5 py-4 text-white/75 font-display font-semibold hover:text-white transition-colors">
          791 122 618
        </a>
      </div>

      <div class="mt-10 pt-6 border-t border-white/10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/40">
        <span>Geodeta uprawniony</span>
        <span>Klienci indywidualni i inwestorzy</span>
      </div>
    </div>

    <div class="lg:col-span-6 xl:col-span-7 lg:pl-4" data-animate>
      <div class="relative overflow-hidden min-h-[420px] sm:min-h-[520px] lg:min-h-[640px]">
        <img id="hero-bg-img" src="/hero-bg-surveying.webp" alt="Geodeta podczas pomiarów w terenie" class="absolute inset-0 w-full h-full object-cover" width="1200" height="900" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
        <div class="absolute left-0 bottom-0 bg-brand-black/90 border-t border-r border-white/10 px-5 py-4 max-w-xs">
          <p class="text-xs uppercase tracking-[0.14em] text-white/35 font-display">KT-GEO</p>
          <p class="text-sm text-white/75 mt-1">Obsługa geodezyjna inwestycji i nieruchomości.</p>
        </div>
      </div>
    </div>
  </div>
</section>
