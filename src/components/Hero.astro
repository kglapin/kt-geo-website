---
---
<section class="relative bg-brand-black overflow-hidden">
  <div class="absolute inset-0 geo-grid opacity-30 pointer-events-none"></div>
  <div class="absolute -top-32 -right-32 w-[520px] h-[520px] rounded-full border border-white/5 pointer-events-none"></div>
  <div class="absolute top-28 right-24 w-2 h-2 rounded-full bg-brand-red shadow-[0_0_0_10px_rgba(227,30,36,0.08)] pointer-events-none"></div>

  <div class="main-grid-container relative z-10 grid grid-cols-1 lg:grid-cols-12 min-h-[calc(100vh-4rem)] lg:min-h-[780px] items-center gap-10 lg:gap-12 py-14 md:py-20 lg:py-16">
    <div class="lg:col-span-7 flex flex-col items-start" data-hero-content>
      <div class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 mb-7">
        <span class="w-2 h-2 rounded-full bg-brand-red"></span>
        <span class="text-xs sm:text-sm font-display font-medium text-white/60 tracking-[0.12em] uppercase">Geodeta · Oleśnica i okolice</span>
      </div>

      <h1 data-hero-h1 class="font-display font-bold text-[2.65rem] sm:text-5xl md:text-6xl lg:text-[4.6rem] text-white tracking-[-0.045em] leading-[0.98] max-w-5xl">
        Od mapy do odbioru budynku.
        <span class="block text-white/65 mt-2">Geodezja bez zbędnych komplikacji.</span>
      </h1>

      <p data-hero-p class="text-base sm:text-lg md:text-xl text-white/55 max-w-2xl leading-relaxed mt-7">
        Mapy do celów projektowych, tyczenie budynków, inwentaryzacje powykonawcze, podziały i sprawy graniczne. Jasny zakres prac, konkretny kolejny krok i dokumentacja przygotowana do dalszego etapu inwestycji.
      </p>

      <div data-hero-cta class="flex flex-col sm:flex-row w-full sm:w-auto items-stretch sm:items-center gap-3 mt-8">
        <a href="#kontakt" class="inline-flex items-center justify-center gap-2 bg-brand-red text-white font-display font-semibold px-7 py-4 rounded-lg transition-all hover:bg-brand-red-dark hover:-translate-y-0.5">
          Wyceń usługę dla swojej działki
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" /></svg>
        </a>
        <a href="tel:791122618" class="inline-flex items-center justify-center gap-2 text-white/75 font-display font-semibold px-6 py-4 rounded-lg border border-white/15 transition-all hover:text-white hover:border-white/30 hover:bg-white/5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          791 122 618
        </a>
      </div>

      <p class="text-sm text-white/35 mt-5 max-w-xl">Nie wiesz, jakiej dokładnie usługi potrzebujesz? Opisz etap inwestycji — pomożemy ustalić właściwy zakres.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full mt-10 pt-7 border-t border-white/10">
        <div class="flex items-center gap-3 text-sm text-white/55">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red shrink-0"></span>
          <span>Geodeta uprawniony</span>
        </div>
        <div class="flex items-center gap-3 text-sm text-white/55">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red shrink-0"></span>
          <span>Oleśnica i okolice</span>
        </div>
        <div class="flex items-center gap-3 text-sm text-white/55">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red shrink-0"></span>
          <span>Od mapy po inwentaryzację</span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 relative" data-animate>
      <div class="relative rounded-2xl overflow-hidden aspect-[4/5] lg:aspect-[4/5] border border-white/10 bg-white/5">
        <img id="hero-bg-img" src="/hero-bg-surveying.webp" alt="Prace geodezyjne w terenie" class="absolute inset-0 w-full h-full object-cover" width="900" height="1125" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/5 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-brand-black/20 to-transparent"></div>

        <div class="absolute left-5 right-5 bottom-5 rounded-xl border border-white/15 bg-black/55 backdrop-blur-md p-5">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-[10px] uppercase tracking-[0.18em] text-white/35 font-display">KT-GEO · pomiar → dokumentacja</p>
              <p class="font-display font-semibold text-white mt-1">Wiesz, czego potrzebujesz i co wydarzy się dalej.</p>
            </div>
            <div class="hidden sm:flex w-11 h-11 rounded-full border border-brand-red/50 items-center justify-center text-brand-red shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
          </div>
        </div>

        <div class="absolute top-5 right-5 rounded-lg border border-white/10 bg-black/45 backdrop-blur-md px-3 py-2 font-mono text-[10px] leading-relaxed text-white/40">
          X 6512347.42<br />Y 5662134.81
        </div>
      </div>
    </div>
  </div>
</section>
