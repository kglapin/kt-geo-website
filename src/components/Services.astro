---
const services = [
  {
    tag: 'Przed projektem',
    title: 'Mapa do celów projektowych',
    description: 'Aktualna mapa dla projektanta z sytuacją terenową i uzbrojeniem, przygotowana jako punkt wyjścia do projektu inwestycji.',
    outcome: 'Dla architekta i dalszych formalności projektowych.',
    image: '/topographic-detail.webp',
    span: 'sm:col-span-2',
    href: '/uslugi/mapa-do-celow-projektowych-olesnica/'
  },
  {
    tag: 'Przed rozpoczęciem robót',
    title: 'Tyczenie budynku',
    description: 'Przeniesienie projektu w teren i wyznaczenie kluczowych punktów zgodnie z dokumentacją.',
    outcome: 'Żeby wykonawca wiedział dokładnie, gdzie zaczynać.',
    image: '/construction-aerial.webp',
    span: '',
    href: '/uslugi/tyczenie-budynku-olesnica/'
  },
  {
    tag: 'Po zakończeniu robót',
    title: 'Inwentaryzacja powykonawcza',
    description: 'Pomiar wykonanych obiektów i przygotowanie dokumentacji potrzebnej do zakończenia inwestycji.',
    outcome: 'Do dalszej procedury odbiorowej budynku.',
    image: '/yellow-surveying.webp',
    span: '',
    href: '/uslugi/inwentaryzacja-powykonawcza-olesnica/'
  },
  {
    tag: 'Działki i granice',
    title: 'Podziały i sprawy graniczne',
    description: 'Podziały nieruchomości oraz prace związane z przebiegiem granic — dobieramy właściwy tryb do konkretnej sytuacji.',
    outcome: 'Jasny zakres i wyjaśnione kolejne kroki.',
    image: '/green-field-aerial.webp',
    span: 'sm:col-span-2',
    href: '/uslugi/podzial-dzialki-olesnica/'
  }
];
---
<section id="uslugi" class="py-20 md:py-28 bg-[#f5f5f5] scroll-mt-16">
  <div class="main-grid-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-12 md:mb-14" data-animate>
      <div class="lg:col-span-8">
        <span class="section-kicker">Zakres usług</span>
        <h2 class="section-title mt-4">Geodezja dopasowana do etapu Twojej inwestycji.</h2>
      </div>
      <p class="section-lead lg:col-span-4 lg:text-right">Nie musisz sam ustalać procedury. Powiedz, co planujesz — wskażemy właściwą usługę.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {services.map((service) => (
        <a
          href={service.href}
          class={`group relative overflow-hidden rounded-2xl ${service.span} min-h-[330px] sm:min-h-[390px] flex items-end border border-black/5`}
          data-animate
        >
          <img
            src={service.image}
            alt={service.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/5 transition-all duration-300 group-hover:from-black/85"></div>
          <div class="relative z-10 p-6 md:p-8 flex flex-col justify-end w-full min-h-[330px] sm:min-h-[390px]">
            <span class="text-[11px] uppercase tracking-[0.17em] font-display font-semibold text-brand-red mb-3">{service.tag}</span>
            <div class="flex items-start justify-between gap-5">
              <div>
                <h3 class="font-display font-bold text-2xl md:text-3xl text-white tracking-tight">{service.title}</h3>
                <p class="text-sm md:text-base text-white/65 leading-relaxed max-w-xl mt-3">{service.description}</p>
                <p class="text-sm text-white font-medium mt-4 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
                  {service.outcome}
                </p>
                <p class="text-xs uppercase tracking-[0.14em] text-white/45 font-display font-semibold mt-5 group-hover:text-white transition-colors">Zobacz szczegóły usługi →</p>
              </div>
              <span class="hidden md:flex w-10 h-10 rounded-full border border-white/20 items-center justify-center text-white/70 shrink-0 group-hover:border-brand-red group-hover:text-brand-red transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" /></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mt-6 rounded-xl border border-[#dfdfdf] bg-white p-5 md:p-6">
      <div>
        <p class="font-display font-semibold text-[#111]">Nie widzisz swojej sprawy?</p>
        <p class="text-sm text-[#666] mt-1">Opisz ją własnymi słowami — ustalimy, jakiego zakresu geodezyjnego potrzebujesz.</p>
      </div>
      <a href="#kontakt" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-red hover:text-brand-red-dark shrink-0">Opisz sprawę →</a>
    </div>
  </div>
</section>
