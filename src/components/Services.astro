---
const services = [
  {
    title: 'Mapa do celów projektowych',
    description: 'Zdobywasz mapę MDCP, która ostatecznie rusza procedurę w urzędzie. Z aktualnym uzbrojeniem i sytuacją wysokościową.',
    benefit: 'Bez tej mapy architekt nie zacznie projektu.',
    image: '/topographic-detail.webp',
    span: 'sm:col-span-2'
  },
  {
    title: 'Tyczenie budynków',
    description: 'Wytyczamy osie budynku zgodnie z projektem, żebyś miał pewność — budowa ruszy dokładnie tam, gdzie należy.',
    benefit: 'Budowa na własnej działce, nie na sąsiada.',
    image: '/construction-aerial.webp',
    span: ''
  },
  {
    title: 'Inwentaryzacje powykonawcze',
    description: 'Kompletna dokumentacja powykonawcza geodezyjna. Niezbędna do odbioru budynku i wpisania do rejestru.',
    benefit: 'Odbiór budynku bez problemów z PINB.',
    image: '/yellow-surveying.webp',
    span: ''
  },
  {
    title: 'Podziały i wznowienia granic',
    description: 'Podział nieruchomości na mniejsze działki. Ustalenie przebiegu granic — przydatne przy ogrodzeniach i rozgraniczeniach.',
    benefit: 'Jasne granice, spokojny sąsiad.',
    image: '/green-field-aerial.webp',
    span: 'sm:col-span-2'
  }
];
---
<section id="uslugi" class="py-20 md:py-28 bg-[#f5f5f5] scroll-mt-16">
  <div class="main-grid-container">
    <div class="flex flex-col gap-4 mb-14" data-animate>
      <span class="text-sm font-display font-medium text-brand-red tracking-widest uppercase">Co robimy</span>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-[#111] tracking-tight">Co możemy dla Ciebie zrobić?</h2>
      <p class="text-[#666] text-lg max-w-xl">Każda usługa zakończona kompletną dokumentacją, gotową do przedłożenia w urzędzie.</p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {services.map((service, i) => (
        <a
          href="#kontakt"
          class={`group relative overflow-hidden rounded-xl ${service.span} min-h-[280px] sm:min-h-[340px] flex items-end`}
        >
          <img
            src={service.image}
            alt={service.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10 transition-all duration-300 group-hover:from-black/70 group-hover:via-black/30"></div>
          <div class="relative z-10 p-6 flex flex-col gap-2 w-full">
            <div class="flex items-center justify-between">
              <h3 class="font-display font-bold text-xl text-white">{service.title}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white/0 group-hover:text-brand-red transition-all duration-300 -translate-x-2 group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" /></svg>
            </div>
            <p class="text-sm text-white/60 leading-relaxed max-w-sm">{service.description}</p>
            <p class="text-xs text-brand-red font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">{service.benefit}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
