---
const steps = [
  {
    number: '01',
    title: 'Opowiedz o projekcie',
    description: 'Opisz działkę i plany. Zadzwoń, napisz lub wypełnij formularz — w 15 minut dostaniesz darmową wycenę.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>`
  },
  {
    number: '02',
    title: 'Pomiary w terenie',
    description: 'Przyjeżdżamy z nowoczesnym sprzętem (GNSS RTK, tachimetr, dron). Minimum Twojego zaangażowania.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`
  },
  {
    number: '03',
    title: 'Dokumentacja gotowa',
    description: 'Odbierasz kompletną dokumentację geodezyjną — zgodną z prawem, gotową do przedłożenia w urzędzie.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  }
];
---
<section class="py-20 md:py-28 bg-white scroll-mt-16">
  <div class="main-grid-container">
    <div class="flex flex-col gap-4 mb-14 text-center" data-animate>
      <span class="text-sm font-display font-medium text-brand-red tracking-widest uppercase">Jak to działa</span>
      <h2 class="font-display font-bold text-3xl md:text-4xl text-[#111] tracking-tight">Geodezja bez komplikacji.<br class="hidden sm:block" /> Twój proces w 3 prostych krokach.</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      {steps.map((step, i) => (
        <div class="flex flex-col items-center text-center gap-5 relative" data-animate>
          <div class="w-14 h-14 rounded-full bg-brand-red/10 flex items-center justify-center text-brand-red">
            <Fragment set:html={step.icon} />
          </div>
          <div class="flex flex-col gap-3">
            <span class="text-xs font-display font-medium text-brand-red tracking-widest uppercase">Krok {step.number}</span>
            <h3 class="font-display font-bold text-xl text-[#111]">{step.title}</h3>
            <p class="text-sm text-[#666] leading-relaxed max-w-xs mx-auto">{step.description}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="hidden md:block absolute top-7 -right-6 lg:-right-8 w-12 lg:w-16">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-full text-[#e5e5e5]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
