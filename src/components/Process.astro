---
const steps = [
  {
    number: '01',
    title: 'Opisujesz sprawę',
    description: 'Podajesz rodzaj inwestycji, lokalizację lub numer działki. Jeśli nie wiesz, jakiej usługi potrzebujesz — to też wystarczy.',
    detail: 'Minimum formalności na starcie.'
  },
  {
    number: '02',
    title: 'Ustalamy zakres i pomiar',
    description: 'Wyjaśniamy, jakie materiały są potrzebne, co wykonujemy i jaki jest kolejny etap. Następnie realizujemy pomiar w terenie.',
    detail: 'Wiesz, co dzieje się dalej.'
  },
  {
    number: '03',
    title: 'Otrzymujesz dokumentację',
    description: 'Przekazujemy opracowanie przygotowane do celu, dla którego zostało zamówione — projektu, budowy, odbioru lub sprawy granicznej.',
    detail: 'Dokumentacja, nie tylko sam pomiar.'
  }
];
---
<section id="jak-pracujemy" class="py-20 md:py-28 bg-white scroll-mt-16">
  <div class="main-grid-container">
    <div class="max-w-3xl mb-14" data-animate>
      <span class="section-kicker">Jak wygląda współpraca</span>
      <h2 class="section-title mt-4">Od pierwszej wiadomości do gotowego opracowania.</h2>
      <p class="section-lead mt-4">Prosty proces, w którym od początku wiadomo, czego dotyczy Twoja sprawa i co będzie kolejnym krokiem.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 border border-[#e5e5e5] rounded-2xl overflow-hidden" data-animate>
      {steps.map((step, index) => (
        <article class={`relative p-7 md:p-8 lg:p-9 min-h-[300px] flex flex-col justify-between gap-10 bg-white ${index < steps.length - 1 ? 'border-b md:border-b-0 md:border-r border-[#e5e5e5]' : ''}`}>
          <div class="flex items-center justify-between">
            <span class="text-xs font-display font-bold tracking-[0.18em] text-brand-red">KROK {step.number}</span>
            <span class="w-8 h-px bg-[#dadada]"></span>
          </div>
          <div>
            <h3 class="font-display font-bold text-2xl text-[#111] tracking-tight">{step.title}</h3>
            <p class="text-[#666] leading-relaxed mt-4">{step.description}</p>
            <p class="text-sm font-semibold text-[#111] mt-5 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
              {step.detail}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
