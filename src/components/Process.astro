---
const steps = [
  {
    number: '01',
    title: 'Kontakt i wycena',
    description: 'Podajesz rodzaj sprawy, lokalizację i — jeśli go znasz — numer działki. Na tej podstawie ustalamy zakres pracy.'
  },
  {
    number: '02',
    title: 'Pomiar i opracowanie',
    description: 'Wykonujemy potrzebne czynności w terenie i przygotowujemy dokumentację właściwą dla danego zlecenia.'
  },
  {
    number: '03',
    title: 'Przekazanie dokumentacji',
    description: 'Otrzymujesz gotowe opracowanie oraz informację, co należy zrobić z nim na kolejnym etapie.'
  }
];
---

<section id="jak-pracujemy" class="py-20 md:py-28 bg-white scroll-mt-16">
  <div class="main-grid-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-12 md:mb-16" data-animate>
      <div class="lg:col-span-5">
        <p class="type-eyebrow">Współpraca</p>
        <h2 class="type-display-lg mt-5 max-w-[9ch]">Jak wygląda zlecenie.</h2>
      </div>
      <div class="lg:col-span-7 lg:pt-10">
        <p class="type-lead max-w-[55ch]">W większości spraw wystarczy krótki kontakt na początku. Ustalamy, czego dotyczy zlecenie, jakie materiały są potrzebne i kiedy możemy wykonać pracę.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 border-t border-[#d9d9d9]" data-animate>
      {steps.map((step, index) => (
        <article class={`py-8 md:py-10 ${index > 0 ? 'md:pl-8 lg:pl-10' : ''} ${index < steps.length - 1 ? 'border-b md:border-b-0 md:border-r border-[#d9d9d9] md:pr-8 lg:pr-10' : ''}`}>
          <p class="type-meta text-[#999]">{step.number}</p>
          <h3 class="type-display-md text-[#111] mt-7">{step.title}</h3>
          <p class="type-body text-[#666] mt-4 max-w-[43ch]">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
