---
const currentYear = new Date().getFullYear();
---
<footer class="bg-brand-black pt-16 pb-8">
  <div class="main-grid-container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-white/10">
      <!-- Logo + desc -->
      <div class="md:col-span-4 flex flex-col gap-4">
        <img src="/kt-geo-logo-white.svg" alt="KT-GEO" class="h-8 w-auto" loading="lazy" />
        <p class="text-sm text-white/40 leading-relaxed max-w-xs">
          Profesjonalne usługi geodezyjne w Oleśnicy i okolicach. mgr inż. Kamil Nowakowski.
        </p>
      </div>

      <!-- Links -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <span class="text-xs font-display font-medium text-white/20 tracking-widest uppercase">Nawigacja</span>
        <a href="#uslugi" class="text-sm text-white/50 hover:text-white transition-colors">Usługi</a>
        <a href="#o-nas" class="text-sm text-white/50 hover:text-white transition-colors">O nas</a>
        <a href="#opinie" class="text-sm text-white/50 hover:text-white transition-colors">Opinie</a>
        <a href="#kontakt" class="text-sm text-white/50 hover:text-white transition-colors">Kontakt</a>
      </div>

      <!-- Contact -->
      <div class="md:col-span-5 flex flex-col gap-3">
        <span class="text-xs font-display font-medium text-white/20 tracking-widest uppercase">Kontakt</span>
        <a href="tel:791122618" class="text-sm text-white/50 hover:text-white transition-colors">791 122 618</a>
        <p class="text-sm text-white/50">ul. Brzozowa 10M/3, 56-400 Oleśnica</p>
        <p class="text-sm text-white/50">NIP: 9112051898 · KRS: 0001094982</p>
      </div>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-xs text-white/20">&copy; {currentYear} KTGEO Sp. z o.o.</p>
      <p class="text-xs text-white/20">Geodezja · Kartografia · Precyzja</p>
    </div>
  </div>
</footer>
