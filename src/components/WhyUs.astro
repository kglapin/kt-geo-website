---
const reasons = [
  {
    number: '01',
    title: 'Wiesz, co będzie dalej',
    description: 'Przed rozpoczęciem wyjaśniamy zakres prac, potrzebne materiały i kolejny etap. Bez geodezyjnego żargonu.'
  },
  {
    number: '02',
    title: 'Dokumentacja ma konkretny cel',
    description: 'Nie kończymy na samym pomiarze. Otrzymujesz opracowanie przygotowane do dalszego etapu inwestycji.'
  },
  {
    number: '03',
    title: 'Kontakt bez krążenia między osobami',
    description: 'Masz jasny punkt kontaktu i konkretne ustalenia dotyczące swojej sprawy.'
  },
  {
    number: '04',
    title: 'Nowoczesny pomiar w terenie',
    description: 'GNSS RTK, tachimetr i rozwiązania dopasowane do rodzaju pracy — technologia ma przyspieszać proces, nie go komplikować.'
  }
];
---

<section class="py-20 md:py-28 bg-brand-black text-white overflow-hidden">
  <div class="main-grid-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28" data-animate>
        <span class="section-kicker">Dlaczego KT-GEO</span>
        <h2 class="font-display font-bold text-4xl md:text-5xl tracking-tight leading-[1.05] mt-4">Geodezja ma ułatwić inwestycję, a nie dokładać kolejnych niewiadomych.</h2>
        <p class="text-white/55 text-lg leading-relaxed mt-6 max-w-xl">Dlatego komunikujemy proces po ludzku, trzymamy się ustalonego zakresu i skupiamy się na tym, czego naprawdę potrzebuje kolejny etap Twojej inwestycji.</p>
        <a href="#kontakt" class="inline-flex items-center gap-2 mt-8 text-sm font-semibold text-white border-b border-brand-red pb-1 hover:text-brand-red transition-colors">
          Opisz swoją sprawę
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" /></svg>
        </a>
      </div>

      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-px bg-white/10 border border-white/10 rounded-2xl overflow-hidden" data-animate>
        {reasons.map((reason) => (
          <article class="bg-brand-black-light p-7 md:p-8 min-h-[240px] flex flex-col justify-between gap-8">
            <span class="text-xs font-display font-semibold tracking-[0.18em] text-brand-red">{reason.number}</span>
            <div>
              <h3 class="font-display font-bold text-xl md:text-2xl tracking-tight">{reason.title}</h3>
              <p class="text-white/50 text-sm leading-relaxed mt-3">{reason.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
