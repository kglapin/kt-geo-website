---
import ServicePage from '../../components/ServicePage.astro';

const forWhom = [
  'rozpoczynasz projekt domu, budynku lub innej inwestycji i projektant potrzebuje aktualnej mapy',
  'chcesz przygotować dokumentację projektową na konkretnej działce',
  'potrzebujesz aktualnego obrazu sytuacji terenowej i uzbrojenia do dalszych prac projektowych'
];

const youGet = [
  'pomiar terenowy w zakresie potrzebnym do opracowania mapy',
  'opracowanie mapy do celów projektowych dla wskazanej inwestycji',
  'jasną informację, jakie dane i materiały są potrzebne przed rozpoczęciem pracy'
];

const steps = [
  { title: 'Podajesz lokalizację', description: 'Wystarczy miejscowość i — jeśli go znasz — numer działki oraz obręb.' },
  { title: 'Ustalamy zakres', description: 'Weryfikujemy potrzeby projektu i wykonujemy niezbędne czynności oraz pomiar w terenie.' },
  { title: 'Otrzymujesz mapę', description: 'Przekazujemy opracowanie przygotowane do wykorzystania w dalszym procesie projektowym.' }
];

const faq = [
  { question: 'Od czego zależy cena mapy do celów projektowych?', answer: 'Od lokalizacji, powierzchni i charakteru terenu, zakresu opracowania oraz dostępnych materiałów. Najszybciej wycenimy usługę po podaniu działki.' },
  { question: 'Jak długo trwa wykonanie mapy?', answer: 'Termin zależy od konkretnej sprawy oraz materiałów potrzebnych do opracowania. Po wskazaniu lokalizacji można podać realny termin realizacji.' },
  { question: 'Czy muszę wiedzieć, jakiego formatu mapy potrzebuje projektant?', answer: 'Nie musisz znać wszystkich parametrów technicznych. W pierwszej rozmowie ustalimy przeznaczenie mapy i potrzebny zakres.' }
];
---

<ServicePage
  seoTitle="Mapa do celów projektowych Oleśnica | KT-GEO"
  description="Mapa do celów projektowych w Oleśnicy i okolicach. Pomiar terenu i opracowanie mapy dla projektanta. Sprawdź zakres i poproś o wycenę."
  eyebrow="Mapa do celów projektowych · Oleśnica"
  title="Mapa, od której może zacząć się Twój projekt."
  intro="Przygotowujemy mapy do celów projektowych dla inwestycji w Oleśnicy i okolicach. Najpierw ustalamy przeznaczenie i zakres, potem wykonujemy pomiar i opracowanie potrzebne projektantowi."
  image="/topographic-detail.webp"
  imageAlt="Fragment opracowania geodezyjnego i pomiar terenu"
  forWhom={forWhom}
  youGet={youGet}
  steps={steps}
  faq={faq}
/>
