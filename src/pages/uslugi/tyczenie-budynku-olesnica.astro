---
import ServicePage from '../../components/ServicePage.astro';

const forWhom = [
  'masz gotowy projekt i przygotowujesz się do rozpoczęcia robót budowlanych',
  'trzeba wyznaczyć w terenie położenie budynku lub innych projektowanych elementów',
  'wykonawca potrzebuje punktów odniesienia zgodnych z dokumentacją projektową'
];

const youGet = [
  'wytyczenie elementów objętych zakresem zlecenia zgodnie z dokumentacją',
  'oznaczenie punktów potrzebnych wykonawcy do rozpoczęcia prac',
  'informację, jakie dokumenty należy przygotować przed terminem tyczenia'
];

const steps = [
  { title: 'Dokumentacja i zakres', description: 'Przekazujesz projekt i lokalizację inwestycji. Ustalamy, jakie elementy mają zostać wytyczone.' },
  { title: 'Tyczenie w terenie', description: 'Przenosimy położenie projektowanych elementów z dokumentacji w teren.' },
  { title: 'Przekazanie punktów', description: 'Po wykonaniu pracy wskazujemy wyznaczone elementy i przekazujemy informacje potrzebne do dalszych robót.' }
];

const faq = [
  { question: 'Kiedy zamówić tyczenie budynku?', answer: 'Przed rozpoczęciem robót wymagających wyznaczenia położenia projektowanego obiektu w terenie. Termin warto ustalić z wyprzedzeniem względem harmonogramu budowy.' },
  { question: 'Jakie dokumenty są potrzebne?', answer: 'Zakres zależy od inwestycji i dokumentacji projektowej. Po pierwszym kontakcie wskażemy, co dokładnie należy przygotować.' },
  { question: 'Czy inwestor musi być na miejscu?', answer: 'Nie zawsze. Zależy to od dostępu do nieruchomości, zakresu tyczenia i organizacji prac. Ustalamy to przed terminem.' }
];
---

<ServicePage
  seoTitle="Tyczenie budynku Oleśnica | KT-GEO"
  description="Tyczenie budynków i obiektów w Oleśnicy i okolicach. Wyznaczenie położenia projektowanego obiektu w terenie zgodnie z dokumentacją."
  eyebrow="Oleśnica i okolice"
  title="Tyczenie budynku"
  intro="Wytyczamy budynki oraz inne projektowane elementy na podstawie dokumentacji projektowej. Przed wykonaniem pracy ustalamy zakres i potrzebne materiały."
  image="/construction-aerial.webp"
  imageAlt="Budowa i prace geodezyjne związane z tyczeniem obiektu"
  forWhom={forWhom}
  youGet={youGet}
  steps={steps}
  faq={faq}
/>
