---
import ServicePage from '../../components/ServicePage.astro';

const forWhom = [
  'chcesz wydzielić z nieruchomości jedną lub kilka nowych działek',
  'przygotowujesz sprzedaż, darowiznę albo inną zmianę układu nieruchomości',
  'potrzebujesz najpierw ustalić, czy planowany podział jest możliwy i jaki będzie jego przebieg'
];

const youGet = [
  'wyjaśnienie kolejnych etapów procesu podziałowego',
  'prace geodezyjne i dokumentację w zakresie właściwym dla konkretnej sprawy',
  'jasną informację, jakie dokumenty lub ustalenia są potrzebne po stronie właściciela'
];

const steps = [
  { title: 'Opisujesz plan podziału', description: 'Podajesz lokalizację nieruchomości i wyjaśniasz, jaki efekt chcesz osiągnąć.' },
  { title: 'Ustalamy właściwy tryb', description: 'Analizujemy zakres geodezyjny i informujemy, jakie kolejne czynności będą potrzebne.' },
  { title: 'Realizujemy prace i dokumentację', description: 'Prowadzimy geodezyjną część procesu zgodnie z ustalonym zakresem.' }
];

const faq = [
  { question: 'Czy każdy podział działki wygląda tak samo?', answer: 'Nie. Tryb i wymagane czynności zależą od celu podziału, nieruchomości oraz uwarunkowań formalnych. Dlatego warto zacząć od konkretnej działki i planowanego efektu.' },
  { question: 'Co podać przy pierwszym kontakcie?', answer: 'Najlepiej lokalizację, numer działki i krótki opis, jak chcesz ją podzielić. To pozwala sprawniej ustalić, jakie informacje będą potrzebne dalej.' },
  { question: 'Czy geodeta prowadzi cały proces administracyjny?', answer: 'Zakres obsługi zależy od konkretnej sprawy. Na początku wyjaśniamy, które elementy leżą po stronie geodety, a które wymagają działań właściciela lub innych uczestników procesu.' }
];
---

<ServicePage
  seoTitle="Podział działki Oleśnica | Geodeta KT-GEO"
  description="Podział działki i nieruchomości w Oleśnicy i okolicach. Wyjaśniamy kolejne kroki, wykonujemy prace geodezyjne i przygotowujemy dokumentację."
  eyebrow="Podział działki · Oleśnica"
  title="Chcesz podzielić działkę? Zacznij od sprawdzenia właściwej drogi."
  intro="Podział nieruchomości to nie tylko pomiar w terenie. Najpierw trzeba ustalić cel, zakres i właściwy przebieg procedury. Pomagamy przejść przez geodezyjną część procesu krok po kroku."
  image="/green-field-aerial.webp"
  imageAlt="Działki i teren objęty pracami geodezyjnymi"
  forWhom={forWhom}
  youGet={youGet}
  steps={steps}
  faq={faq}
/>
