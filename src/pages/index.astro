---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import TrustSection from '../components/TrustSection.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';
import MobileCta from '../components/MobileCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Geodeta Oleśnica i okolice | KT-GEO"
  description="Usługi geodezyjne w Oleśnicy i okolicach: mapy do celów projektowych, tyczenie budynków, inwentaryzacje powykonawcze, podziały nieruchomości i prace związane z granicami działek."
>
  <Header />

  <main class="flex-grow">
    <Hero />
    <Services />
    <TrustSection />
    <Process />
    <Reviews />
    <ContactForm />
  </main>

  <Footer />
  <MobileCta />
</Layout>
